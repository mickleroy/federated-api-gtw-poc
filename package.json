{
  "name": "api-gtw-poc",
  "version": "1.0.0",
  "description": "API Gateway POC with multiple NodeJS APIs",
  "scripts": {
    "combine-specs": "ts-node api-gateway/scripts/combine-openapi.ts",
    "deploy:all": "npm run deploy:apis && npm run deploy:gateway",
    "deploy:apis": "npm run deploy:product && npm run deploy:customer",
    "deploy:gateway": "chmod +x api-gateway/scripts/deploy-gateway.sh && ./api-gateway/scripts/deploy-gateway.sh",
    "deploy:product": "cd apis/product-api && cdk deploy",
    "deploy:customer": "cd apis/customer-api && cdk deploy",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "generate-types": "openapi-typescript apis/**/openapi.yaml --output shared/types/"
  },
  "workspaces": [
    "apis/*",
    "api-gateway",
    "shared/*"
  ],
  "devDependencies": {
    "@types/node": "^20.11.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "openapi-typescript": "^6.7.3",
    "js-yaml": "^4.1.0"
  }
} 