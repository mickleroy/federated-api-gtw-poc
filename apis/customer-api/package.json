{
  "name": "customer-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.api.json",
    "build:cdk": "tsc -p tsconfig.json",
    "test": "jest",
    "cdk": "cdk",
    "deploy": "npm run build:cdk && cdk deploy --context vpcId=$VPC_ID && cd scripts && npm run publish",
    "publish": "cd scripts && ./publish.sh",
    "generate-types": "openapi-typescript openapi.yaml --output src/generated/types.d.ts"
  },
  "dependencies": {
    "aws-sdk": "^2.1550.0",
    "aws-cdk-lib": "^2.126.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.133",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "aws-cdk": "^2.126.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "openapi-typescript": "^6.7.4"
  }
} 